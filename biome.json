{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/test-results",
      "!!**/playwright-report",
      "!!**/blob-report",
      "!!pnpm-lock.yaml",
      "!AGENTS.md",
      "!LICENSE",
      "!.changeset/**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "domains": {
      "react": "recommended"
    }
  }
}
